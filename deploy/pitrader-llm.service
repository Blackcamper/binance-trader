[Unit]
Description=pitrader daily status text from the local model on the NAS (no trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/binance-trader
ExecStart=/usr/bin/python3 -m pitrader llm-summary
Nice=15
NoNewPrivileges=true
